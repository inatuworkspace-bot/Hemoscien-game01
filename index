    <script>
        // Web Audio API 擬真零依賴音效
        class SoundEffects {
            constructor() {
                this.enabled = true;
                this.ctx = null;
            }

            init() {
                if (!this.ctx) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    this.ctx = new AudioContext();
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }

            playTap() {
                if (!this.enabled) return;
                this.init();
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(440, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(880, this.ctx.currentTime + 0.08);
                gain.gain.setValueAtTime(0.12, this.ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + 0.08);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.08);
            }

            playSuccess() {
                if (!this.enabled) return;
                this.init();
                const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
                notes.forEach((freq, idx) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, this.ctx.currentTime + idx * 0.1);
                    gain.gain.setValueAtTime(0.18, this.ctx.currentTime + idx * 0.1);
                    gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + idx * 0.1 + 0.35);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(this.ctx.currentTime + idx * 0.1);
                    osc.stop(this.ctx.currentTime + idx * 0.1 + 0.35);
                });
            }

            playError() {
                if (!this.enabled) return;
                this.init();
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(220, this.ctx.currentTime);
                osc.frequency.setValueAtTime(160, this.ctx.currentTime + 0.1);
                gain.gain.setValueAtTime(0.15, this.ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + 0.25);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.25);
            }
        }

        const sound = new SoundEffects();

        const WORD_POOL = ['HEMOSCIEN', 'INFOMED', 'HF440', 'DIMI', 'CYTOSORB'];

        const WORD_DESCRIPTIONS = {
            'HEMOSCIEN': '<b>英禾美生醫 (Hemoscien)</b>：深耕急重症照護與血液淨化領域，秉持「重生紅」的生命力與「專注灰」的嚴謹專業。',
            'INFOMED': '<b>瑞士原廠 Infomed</b>：享譽全球的高階血液淨化設備研發製造領導者，提供精密穩定的臨床治療平台。',
            'HF440': '<b>HF440 血液淨化平台</b>：支援全方位治療模式（CKRT、DFPP、雙重抗凝策略及獨家 ECMO 串聯模式）。',
            'DIMI': '<b>DIMI 透析系統</b>：創新精巧的血液淨化設備，提供病患更人性化、更高品質的治療體驗。',
            'CYTOSORB': '<b>CytoSorb 血液吸附器</b>：專為移除體內過量細胞激素與發炎物質設計，協助穩定重症患者血行動力與免疫平衡。'
        };

        const GRID_SIZE = 10;
        const GAME_DURATION = 30; // 30秒

        let gameState = {
            targetWord: '',
            grid: [],
            wordPlacement: null,
            timer: GAME_DURATION,
            timerInterval: null,
            firstSelectedCell: null,
            currentPath: [],
            isDragging: false,
            isGameOver: false
        };

        function createEmptyGrid(size) {
            return Array.from({ length: size }, () => Array(size).fill(''));
        }

        // 所有 8 個方向 (水平左至右、右至左、垂直上至下、下至上、4種對角線)
        const DIRECTIONS = [
            { r: 0, c: 1, name: '水平左至右' },
            { r: 0, c: -1, name: '水平右至左' },
            { r: 1, c: 0, name: '垂直上至下' },
            { r: -1, c: 0, name: '垂直下至上' },
            { r: 1, c: 1, name: '斜向左上至右下' },
            { r: 1, c: -1, name: '斜向右上至左下' },
            { r: -1, c: 1, name: '斜向左下至右上' },
            { r: -1, c: -1, name: '斜向右下至左上' }
        ];

        function canPlaceWord(grid, word, startR, startC, dir) {
            const endR = startR + dir.r * (word.length - 1);
            const endC = startC + dir.c * (word.length - 1);

            if (endR < 0 || endR >= GRID_SIZE || endC < 0 || endC >= GRID_SIZE) {
                return false;
            }

            for (let i = 0; i < word.length; i++) {
                const r = startR + dir.r * i;
                const c = startC + dir.c * i;
                if (grid[r][c] !== '' && grid[r][c] !== word[i]) {
                    return false;
                }
            }
            return true;
        }

        function placeWordInGrid(grid, word) {
            // 嘗試隨機方向與起點
            const shuffledDirs = [...DIRECTIONS].sort(() => Math.random() - 0.5);
            for (const dir of shuffledDirs) {
                // 建立所有可用起點
                const candidates = [];
                for (let r = 0; r < GRID_SIZE; r++) {
                    for (let c = 0; c < GRID_SIZE; c++) {
                        if (canPlaceWord(grid, word, r, c, dir)) {
                            candidates.push({ r, c });
                        }
                    }
                }
                if (candidates.length > 0) {
                    const chosen = candidates[Math.floor(Math.random() * candidates.length)];
                    const path = [];
                    for (let i = 0; i < word.length; i++) {
                        const curR = chosen.r + dir.r * i;
                        const curC = chosen.c + dir.c * i;
                        grid[curR][curC] = word[i];
                        path.push({ r: curR, c: curC });
                    }
                    return { word, path, dir };
                }
            }
            return null;
        }

        function generateBoard(targetWord) {
            let success = false;
            let finalGrid = [];
            let targetPlacement = null;
            let attempts = 0;

            // 高頻醫療與展會英文字母干擾池
            const MEDICAL_LETTERS = "ACDEFHILMNOPRSTU40";

            while (!success && attempts < 50) {
                attempts++;
                const tempGrid = createEmptyGrid(GRID_SIZE);

                // 1. 優先放置目標關鍵字
                const targetResult = placeWordInGrid(tempGrid, targetWord);
                if (!targetResult) continue;

                // 2. 隨機安插題庫其他單字增加探索真實性
                const otherWords = WORD_POOL.filter(w => w !== targetWord);
                for (const w of otherWords) {
                    placeWordInGrid(tempGrid, w);
                }

                // 3. 填滿空白格子
                for (let r = 0; r < GRID_SIZE; r++) {
                    for (let c = 0; c < GRID_SIZE; c++) {
                        if (tempGrid[r][c] === '') {
                            tempGrid[r][c] = MEDICAL_LETTERS[Math.floor(Math.random() * MEDICAL_LETTERS.length)];
                        }
                    }
                }

                finalGrid = tempGrid;
                targetPlacement = targetResult;
                success = true;
            }

            return { grid: finalGrid, placement: targetPlacement };
        }

        const gameBoardEl = document.getElementById('gameBoard');

        function renderBoardDOM(grid) {
            gameBoardEl.innerHTML = '';
            for (let r = 0; r < GRID_SIZE; r++) {
                for (let c = 0; c < GRID_SIZE; c++) {
                    const cell = document.createElement('div');
                    cell.className = 'grid-cell bg-slate-50 border border-slate-200 text-slate-800 text-sm sm:text-base cursor-pointer';
                    cell.textContent = grid[r][c];
                    cell.dataset.r = r;
                    cell.dataset.c = c;
                    gameBoardEl.appendChild(cell);
                }
            }
        }

        function getCellElement(r, c) {
            return gameBoardEl.querySelector(`[data-r="${r}"][data-c="${c}"]`);
        }

        function getCellFromPoint(clientX, clientY) {
            const el = document.elementFromPoint(clientX, clientY);
            if (el && el.classList.contains('grid-cell')) {
                return {
                    r: parseInt(el.dataset.r, 10),
                    c: parseInt(el.dataset.c, 10),
                    element: el
                };
            }
            return null;
        }

        // 計算起點到終點之間的直角或45度對角線所有格子
        function calculateStraightLine(startR, startC, endR, endC) {
            const dr = endR - startR;
            const dc = endC - startC;
            const distR = Math.abs(dr);
            const distC = Math.abs(dc);

            // 必須是：水平、垂直、或嚴格對角線 (斜率 1 或 -1)
            const isHorizontal = distR === 0 && distC > 0;
            const isVertical = distC === 0 && distR > 0;
            const isDiagonal = distR === distC && distR > 0;

            if (!isHorizontal && !isVertical && !isDiagonal) {
                return null;
            }

            const stepR = dr === 0 ? 0 : dr / distR;
            const stepC = dc === 0 ? 0 : dc / distC;
            const steps = Math.max(distR, distC);

            const path = [];
            for (let i = 0; i <= steps; i++) {
                path.push({
                    r: startR + stepR * i,
                    c: startC + stepC * i
                });
            }
            return path;
        }

        function highlightPath(path) {
            // 清除之前的選取
            gameBoardEl.querySelectorAll('.grid-cell').forEach(cell => {
                cell.classList.remove('cell-selected');
            });

            if (!path || path.length === 0) {
                document.getElementById('currentSelection').textContent = '--';
                return;
            }

            let wordSelected = '';
            path.forEach(pt => {
                const el = getCellElement(pt.r, pt.c);
                if (el) {
                    el.classList.add('cell-selected');
                    wordSelected += el.textContent;
                }
            });

            document.getElementById('currentSelection').textContent = wordSelected;
        }

        function checkSelection(path) {
            if (!path || path.length === 0) return false;

            let forward = '';
            path.forEach(pt => {
                forward += gameState.grid[pt.r][pt.c];
            });
            const backward = forward.split('').reverse().join('');

            if (forward === gameState.targetWord || backward === gameState.targetWord) {
                handleSuccess();
                return true;
            } else {
                // 錯誤震動回饋
                sound.playError();
                gameBoardEl.classList.add('shake');
                setTimeout(() => gameBoardEl.classList.remove('shake'), 450);
                clearSelection();
                return false;
            }
        }

        function clearSelection() {
            if (gameState.firstSelectedCell) {
                const el = getCellElement(gameState.firstSelectedCell.r, gameState.firstSelectedCell.c);
                if (el) el.classList.remove('cell-first-tap');
            }
            gameState.firstSelectedCell = null;
            gameState.currentPath = [];
            highlightPath([]);
        }

        function setupInteraction() {
            // 1. 拖曳選取 (Pointer Drag)
            gameBoardEl.addEventListener('pointerdown', (e) => {
                if (gameState.isGameOver) return;
                sound.init();

                const cellData = getCellFromPoint(e.clientX, e.clientY);
                if (!cellData) return;

                gameState.isDragging = true;
                gameState.dragStart = { r: cellData.r, c: cellData.c };
                gameState.currentPath = [{ r: cellData.r, c: cellData.c }];
                highlightPath(gameState.currentPath);
                sound.playTap();
            });

            window.addEventListener('pointermove', (e) => {
                if (!gameState.isDragging || gameState.isGameOver) return;
                const cellData = getCellFromPoint(e.clientX, e.clientY);
                if (!cellData) return;

                const path = calculateStraightLine(
                    gameState.dragStart.r,
                    gameState.dragStart.c,
                    cellData.r,
                    cellData.c
                );

                if (path) {
                    gameState.currentPath = path;
                    highlightPath(path);
                }
            });

            window.addEventListener('pointerup', () => {
                if (!gameState.isDragging) return;
                gameState.isDragging = false;

                // 若拖曳長度大於 1，直接判定
                if (gameState.currentPath.length > 1) {
                    checkSelection(gameState.currentPath);
                } else if (gameState.currentPath.length === 1) {
                    // 若只點擊了單一格子，進入「兩段式點擊」模式 (Tap First -> Tap Last)
                    handleTapSelection(gameState.currentPath[0]);
                }
            });

            // 2. 兩段式點擊模式 (Click First -> Click Last)
            function handleTapSelection(pt) {
                if (!gameState.firstSelectedCell) {
                    // 第一次點擊：標記起點
                    gameState.firstSelectedCell = pt;
                    const el = getCellElement(pt.r, pt.c);
                    el.classList.add('cell-first-tap');
                    document.getElementById('currentSelection').textContent = el.textContent;
                    document.getElementById('interactionGuide').innerHTML = `
                        <span class="text-hemo-red font-extrabold animate-pulse">
                            <i class="fa-solid fa-bullseye"></i> 起點已鎖定，請點擊終點字母！
                        </span>
                    `;
                } else {
                    // 第二次點擊：計算直角連線
                    const start = gameState.firstSelectedCell;
                    const end = pt;

                    // 取消首字特殊外框
                    const startEl = getCellElement(start.r, start.c);
                    if (startEl) startEl.classList.remove('cell-first-tap');

                    if (start.r === end.r && start.c === end.c) {
                        // 點擊同一格：取消
                        clearSelection();
                        document.getElementById('interactionGuide').innerHTML = `<i class="fa-regular fa-hand-point-up text-hemo-red"></i> 請點首末字或滑動選取`;
                        return;
                    }

                    const path = calculateStraightLine(start.r, start.c, end.r, end.c);
                    if (path) {
                        highlightPath(path);
                        checkSelection(path);
                    } else {
                        sound.playError();
                        clearSelection();
                    }
                    document.getElementById('interactionGuide').innerHTML = `<i class="fa-regular fa-hand-point-up text-hemo-red"></i> 請點首末字或滑動選取`;
                }
            }
        }

        function startTimer() {
            clearInterval(gameState.timerInterval);
            gameState.timer = GAME_DURATION;
            updateTimerDisplay();

            gameState.timerInterval = setInterval(() => {
                if (gameState.isGameOver) return;
                gameState.timer--;
                updateTimerDisplay();

                if (gameState.timer <= 0) {
                    clearInterval(gameState.timerInterval);
                    handleTimeout();
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            const timerText = document.getElementById('timerText');
            const timerBar = document.getElementById('timerBar');

            timerText.textContent = gameState.timer;
            const pct = (gameState.timer / GAME_DURATION) * 100;
            timerBar.style.width = `${pct}%`;

            if (gameState.timer <= 10) {
                timerText.classList.add('text-hemo-red', 'animate-pulse');
                timerBar.classList.remove('bg-hemo-red');
                timerBar.classList.add('bg-red-600');
            } else {
                timerText.classList.remove('text-hemo-red', 'animate-pulse');
                timerBar.classList.add('bg-hemo-red');
                timerBar.classList.remove('bg-red-600');
            }
        }

        function handleSuccess() {
            gameState.isGameOver = true;
            clearInterval(gameState.timerInterval);
            sound.playSuccess();

            // 五彩紙花特效
            confetti({
                particleCount: 80,
                spread: 70,
                origin: { y: 0.6 },
                colors: ['#C30D23', '#BFC0C0', '#D97706', '#ffffff']
            });

            // 準備彈窗資訊
            const timeUsed = GAME_DURATION - gameState.timer;
            document.getElementById('winWordText').textContent = gameState.targetWord;
            document.getElementById('winTimeUsed').textContent = `${timeUsed} 秒 (剩餘 ${gameState.timer} 秒)`;
            document.getElementById('wordIntroText').innerHTML = WORD_DESCRIPTIONS[gameState.targetWord] || '';
            document.getElementById('authCode').textContent = `HEMO-${Math.floor(1000 + Math.random() * 9000)}-WIN`;

            setTimeout(() => {
                document.getElementById('successModal').classList.remove('hidden');
            }, 300);
        }

        function handleTimeout() {
            gameState.isGameOver = true;
            sound.playError();
            document.getElementById('failWordText').textContent = gameState.targetWord;
            document.getElementById('failModal').classList.remove('hidden');
        }

        function showHint() {
            if (gameState.isGameOver || !gameState.wordPlacement) return;
            sound.playTap();

            // 將答案的第一個字母閃爍標記
            const firstPt = gameState.wordPlacement.path[0];
            const el = getCellElement(firstPt.r, firstPt.c);
            if (el) {
                el.classList.add('cell-hint');
                setTimeout(() => el.classList.remove('cell-hint'), 2500);
            }
        }

        function revealAnswerOnBoard() {
            document.getElementById('failModal').classList.add('hidden');
            if (!gameState.wordPlacement) return;

            gameState.wordPlacement.path.forEach(pt => {
                const el = getCellElement(pt.r, pt.c);
                if (el) {
                    el.classList.add('bg-amber-300', 'text-amber-950', 'font-black');
                }
            });
        }

        function startNewGame() {
            gameState.isGameOver = false;
            clearSelection();

            // 1. 隨機選題
            const randomTarget = WORD_POOL[Math.floor(Math.random() * WORD_POOL.length)];
            gameState.targetWord = randomTarget;
            document.getElementById('targetWordBadge').textContent = randomTarget;

            // 2. 生成 10x10 盤面
            const generated = generateBoard(randomTarget);
            gameState.grid = generated.grid;
            gameState.wordPlacement = generated.placement;

            // 3. 渲染盤面 DOM
            renderBoardDOM(gameState.grid);

            // 4. 切換畫面
            document.getElementById('startScreen').classList.add('hidden');
            document.getElementById('successModal').classList.add('hidden');
            document.getElementById('failModal').classList.add('hidden');
            document.getElementById('gameScreen').classList.remove('hidden');
            document.getElementById('gameScreen').classList.add('flex');

            // 5. 啟動計時
            startTimer();
        }

        function returnToHome() {
            clearInterval(gameState.timerInterval);
            gameState.isGameOver = true;
            document.getElementById('successModal').classList.add('hidden');
            document.getElementById('failModal').classList.add('hidden');
            document.getElementById('gameScreen').classList.add('hidden');
            document.getElementById('gameScreen').classList.remove('flex');
            document.getElementById('startScreen').classList.remove('hidden');
        }

        // 綁定所有按鈕事件
        document.getElementById('startGameBtn').addEventListener('click', () => {
            sound.init();
            startNewGame();
        });

        document.getElementById('playAgainBtn').addEventListener('click', () => {
            startNewGame();
        });

        document.getElementById('retryBtn').addEventListener('click', () => {
            startNewGame();
        });

        document.getElementById('backHomeBtn').addEventListener('click', () => {
            returnToHome();
        });

        document.getElementById('inspectBoardBtn').addEventListener('click', () => {
            revealAnswerOnBoard();
        });

        document.getElementById('hintBtn').addEventListener('click', () => {
            showHint();
        });

        document.getElementById('clearSelectionBtn').addEventListener('click', () => {
            clearSelection();
        });

        // 音效開關
        const soundBtn = document.getElementById('soundToggleBtn');
        const soundIcon = document.getElementById('soundIcon');
        soundBtn.addEventListener('click', () => {
            sound.enabled = !sound.enabled;
            if (sound.enabled) {
                soundIcon.className = 'fa-solid fa-volume-high text-hemo-red';
            } else {
                soundIcon.className = 'fa-solid fa-volume-xmark text-slate-400';
            }
        });

        // 頁面載入就緒
        window.addEventListener('load', () => {
            setupInteraction();
        });
    </script>
</body>
</html>
